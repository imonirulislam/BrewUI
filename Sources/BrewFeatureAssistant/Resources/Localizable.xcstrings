    "That request is too long for the on-device model. Try a shorter description." : {
      "comment" : "Assistant: request exceeded the model's context window",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La solicitud es demasiado larga para el modelo integrado. Prueba con una descripción más corta."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "요청이 기기 내 모델에 비해 너무 깁니다. 더 짧게 설명해 보세요."
          }
        },
        "sv" : {
          "stringUnit" : {
